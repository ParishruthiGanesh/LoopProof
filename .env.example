# LoopProof environment. Copy to .env.local and fill in what you need.
# .env.local is gitignored. Do not commit real secrets to this file.

# ---------------------------------------------------------------- database
# SQLite file, relative to the project root unless absolute.
LOOPPROOF_DATABASE_PATH=data/loopproof.db

# Where uploaded photographs are written. Kept outside the repository and
# served only through /api/photos, never as static files.
LOOPPROOF_UPLOAD_DIR=data/uploads

# ----------------------------------------------------------------- session
# HMAC key for session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app warns on /api/status while this is left at its development default.
LOOPPROOF_SESSION_SECRET=

# Used to build the absolute URL encoded into item QR codes.
LOOPPROOF_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------- AI
# Without a key, listing creation still works in full and the app offers
# clearly labelled prerecorded example analyses instead. It never claims that
# an uploaded photograph was analysed when it was not.
ANTHROPIC_API_KEY=
LOOPPROOF_AI_MODEL=claude-sonnet-4-5
LOOPPROOF_AI_TIMEOUT_MS=45000

# ------------------------------------------------------------------- chain
# Local development chain. `npm run chain:deploy` writes the contract address
# and the three organization wallet keys into .env.local for you.
LOOPPROOF_RPC_URL=http://127.0.0.1:8545
LOOPPROOF_CHAIN_ID=31337
LOOPPROOF_CHAIN_LABEL="Local development chain (Hardhat, chainId 31337)"
LOOPPROOF_CONTRACT_ADDRESS=

# Per-organization signing keys, server-side only. These are written by
# `npm run chain:deploy` using the well-known public Hardhat development
# accounts, which hold no real value and exist only on the local chain.
# NEVER put a key controlling real funds here.
LOOPPROOF_WALLET_KEY_ORG_NORTHFIELD_SURPLUS=
LOOPPROOF_WALLET_KEY_ORG_HARBOURSIDE_LEARNING=
LOOPPROOF_WALLET_KEY_ORG_RELOOP_COLLECTIVE=

# Opt-in only. When true, chain writes are recorded with status "simulated"
# and are labelled as such everywhere in the interface. Leave it false unless
# you specifically want that mode: nothing is ever labelled simulated by
# accident.
LOOPPROOF_CHAIN_SIMULATION=false
