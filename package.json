{
  "name": "loopproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/contracts/tsconfig.json",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reset.ts",
    "chain:node": "hardhat node",
    "chain:deploy": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/deploy-contract.ts",
    "chain:test": "TS_NODE_PROJECT=test/contracts/tsconfig.json TS_NODE_TRANSPILE_ONLY=1 hardhat test",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "setup": "npx hardhat compile && npm run db:reset",
    "verify:all": "npm run typecheck && npm run chain:test && npm run test && npm run build",
    "chain:anchor": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/anchor-seed.ts",
    "illustrations": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/generate-illustrations.ts",
    "abi:sync": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/sync-abi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.5",
    "next": "^15.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "viem": "^2.37.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "hardhat": "^2.26.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}